    {
      "id": "zoo-navigator",
      "title": {
        "en": "Zoo Navigator",
        "zh": "动物园导航"
      },
      "subtitle": {
        "en": "An Android app for planning a zoo visit",
        "zh": "规划动物园行程的 Android 应用"
      },
      "date_range": {
        "start": "2022-03",
        "end": "2022-06",
        "label": {
          "en": "March–June 2022",
          "zh": "2022 年 3–6 月"
        }
      },
      "role": {
        "en": "Backend software development lead",
        "zh": "后端软件开发负责人"
      },
      "collaborators": [
        "Yukati Gupta",
        "Nicholas Primero",
        "Aidan Antos",
        "Lindsey Manzano",
        "Galen Ng"
      ],
      "overview": {
        "en": "Choose the animals you want to see, then find a route through the San Diego Zoo. I led the search and navigation backend for an Android app that turns a list of favorite exhibits into a visit plan.",
        "zh": "选出想看的动物，再找到穿行圣地亚哥动物园的路线。我负责这款 Android 应用的搜索与导航后端，将一份想去的展区清单转化为游览计划。"
      },
      "tools": ["Android Studio", "Dijkstra’s algorithm"],
      "links": [],
      "sections": [
        {
          "id": "from-search-to-a-visit-list",
          "title": {
            "en": "From search to a visit list",
            "zh": "从搜索到行程清单"
          },
          "paragraphs": [
            {
              "en": "The search accepts partial animal names, so visitors can find exhibits without typing a complete name. They add the places they want to visit, then choose between detailed navigation and a simpler guide. I was responsible for the search and navigation systems behind this flow.",
              "zh": "搜索支持输入部分动物名称，游客不必打完完整名称就能找到展区。选好想去的地点后，可以使用详细导航或更简洁的导览。我负责实现这段流程背后的搜索与导航系统。"
            }
          ],
          "images": [],
          "layout": "text"
        },
        {
          "id": "turning-the-map-into-a-graph",
          "title": {
            "en": "Turning the map into a graph",
            "zh": "把地图变成路径图"
          },
          "paragraphs": [
            {
              "en": "We manually imported the zoo map as connected locations and roads. Each road carries a distance, allowing Dijkstra’s algorithm to calculate shortest paths from the visitor’s location. This is the foundation for navigation between selected stops.",
              "zh": "我们手动导入动物园地图，将地点与道路构成一张连接图。每条道路带有距离权重，Dijkstra 算法据此计算从游客当前位置出发的最短路径，为所选地点之间的导航提供基础。"
            }
          ],
          "images": [
            {
              "src": "assets/portfolio/page-21-image-01.png",
              "width": 1765,
              "height": 945,
              "caption": {
                "en": "Zoo route weighted graph",
                "zh": "动物园路线的加权图"
              },
              "small": false
            }
          ],
          "layout": "paired"
        },
        {
          "id": "testing-the-parts-and-the-journey",
          "title": {
            "en": "Testing the parts and the journey",
            "zh": "测试功能，也测试完整行程"
          },
          "paragraphs": [
            {
              "en": "We built the app in Android Studio with functions separated into modules. I ran unit tests for individual features and integration tests that followed the overall visitor flow, checking how search, planning, and navigation worked together.",
              "zh": "应用在 Android Studio 中开发，各项功能拆分为独立模块。我对单项功能进行单元测试，再用集成测试模拟完整游览流程，检查搜索、规划与导航如何共同工作。"
            }
          ],
          "images": [
            {
              "src": "assets/portfolio/page-21-image-03.jpg",
              "width": 718,
              "height": 340,
              "caption": {
                "en": "Zoo path JSON data structure",
                "zh": "动物园路径的 JSON 数据结构"
              },
              "small": false
            }
          ],
          "layout": "paired"
        }
      ],
      "cover_images": [
        {
          "src": "assets/portfolio/page-20-image-02.jpg",
          "width": 542,
          "height": 1161,
          "caption": {
            "en": "Zoo Navigator animal search and visit planner",
            "zh": "Zoo Navigator 的动物搜索与游览规划"
          },
          "small": false
        }
      ],
      "design_question": {
        "en": "How can a list of animals become a route a visitor can follow?",
        "zh": "如何把想看的动物清单，变成游客能够跟随的路线？"
      },
      "hero_layout": "phone",
