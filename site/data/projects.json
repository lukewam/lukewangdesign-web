    {
      "id": "disaster-defender",
      "title": {
        "en": "Disaster Defender",
        "zh": "灾难守护者"
      },
      "subtitle": {
        "en": "A VR emergency-response game",
        "zh": "VR 应急救援游戏"
      },
      "date_range": {
        "start": "2024-03",
        "end": "2024-06",
        "label": {
          "en": "March–June 2024",
          "zh": "2024 年 3–6 月"
        }
      },
      "role": {
        "en": "User interaction and testing lead",
        "zh": "用户交互与测试负责人"
      },
      "collaborators": ["Matthew Mizumoto", "Jack Barkes", "Bran Zhang"],
      "overview": {
        "en": "A Meta Quest 2 game set in an urban disaster scene. Players locate injured people, select first-aid items, and follow guided actions against the clock. I led interaction design and testing, from controller input to hand tracking.",
        "zh": "一款发生在城市灾后场景中的 Meta Quest 2 游戏。玩家需要在限定时间内找到伤者、选择急救物品，并依照指引操作。我负责交互与测试，从手柄输入逐步探索到手部追踪。"
      },
      "tools": ["Unity", "C#", "Meta Quest 2", "Meta Interaction SDK"],
      "links": [],
      "sections": [
        {
          "id": "building-the-first-interactions",
          "title": {
            "en": "Building the first interactions",
            "zh": "先建立基本操作"
          },
          "paragraphs": [
            {
              "en": "I built a medical-room prototype in Unity and C# to develop selection, object manipulation, and movement. A controller ray selects items and points to teleport destinations. Directional arrows lead toward injured people, while a menu lets players choose equipment and enter text.",
              "zh": "我用 Unity 和 C# 搭建医疗室原型，开发选择、物体操作与移动。手柄射线用于选取物品和指定传送位置；方向箭头引导玩家接近伤者，菜单则用于选择器材和输入文字。"
            }
